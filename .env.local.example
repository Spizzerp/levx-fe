# App environment
APP_ENV=local
APP_API_BASE_URL=

# Pyth Hermes SSE endpoint (required)
# Dev/testnet: https://hermes.pyth.network
# Prod: use your provider-hosted endpoint (Triton/Helius/QuickNode)
APP_HERMES_URL=https://hermes.pyth.network

# Solana RPC endpoint (required)
# Dev: https://api.devnet.solana.com
# Prod: use your provider-hosted endpoint
APP_RPC_URL=https://api.devnet.solana.com

# Network: 'devnet' or 'mainnet' (required)
APP_NETWORK=devnet
