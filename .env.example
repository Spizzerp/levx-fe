# Required
APP_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
APP_NETWORK=devnet
APP_PROGRAM_ID=LEVXqi1Z2XujBw2jAEP15Dv8LyrDetDR95KZGGQNobV

# Optional
APP_ENV=local
# Required for chart history: the pipeline's public URL (empty asks the frontend's own host)
APP_API_BASE_URL=
# Live price source: "free" (Coinbase trades kept on Pyth's level, the default) or "pyth" (Hermes)
APP_PRICE_SOURCE=free
# Required only when APP_PRICE_SOURCE=pyth
APP_HERMES_URL=https://hermes.pyth.network
APP_PATH_UPLOAD_RELAY_FEE_LAMPORTS=50000
APP_EIGENCACHE_QUOTES_ENABLED=false
# Comma-separated admin wallet pubkeys (base58)
APP_ADMIN_WALLETS=
# Set to "true" to use mock API responses during development
APP_USE_MOCK=

# Supabase
APP_SUPABASE_URL=http://127.0.0.1:54321
APP_SUPABASE_ANON_KEY=
